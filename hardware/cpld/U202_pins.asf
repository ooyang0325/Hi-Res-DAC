# U202 AGRV2KQ32 pin assignments (Supra settings file, Quartus .qsf syntax), from the routed netlist.
# check_cpld_pins.py fails CI if this file and the schematic netlist disagree.
set_location_assignment PIN_1 -to FAM_CLK
set_location_assignment PIN_3 -to CPLD_IRQ
# Pin 4 is the dedicated NRST pad; Supra names it PIN_NRST and routes it into the fabric (fit 15 Oct 2026).
set_location_assignment PIN_NRST -to CPLD_NRST
set_location_assignment PIN_8 -to OSC44_EN
set_location_assignment PIN_9 -to LINK_SCK
set_location_assignment PIN_13 -to LRCLK_FB
set_location_assignment PIN_18 -to N2_BCLK_SRC
set_location_assignment PIN_19 -to N2_LRCLK_SRC
set_location_assignment PIN_20 -to N2_SDATA_SRC
set_location_assignment PIN_21 -to N2_CPY_CK
set_location_assignment PIN_22 -to N2_CPY_SD
set_location_assignment PIN_23 -to MCLK_EN
set_location_assignment PIN_26 -to LINK_FRAME
set_location_assignment PIN_27 -to LINK_MOSI
set_location_assignment PIN_28 -to LINK_MISO
set_location_assignment PIN_31 -to OSC48_EN
# OD-16: LINK_SCK (pin 9 is not an IO_GB pin) must be promoted to a global clock network.
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to LINK_SCK
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to FAM_CLK
# Layout review R2: <= 8 mA drive or slow slew on pins 28 and 13. Supra 2026.09 applies SLEW_RATE 0 as
# CFG_SLR = 1 on these two pins only (routed netlist); CURRENT_STRENGTH_NEW is accepted but leaves
# CFG_PDRCTRL at the default 4'b0100 on every pin, so slow slew is what meets R2.
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to LINK_MISO
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to LRCLK_FB
set_instance_assignment -name SLEW_RATE 0 -to LINK_MISO
set_instance_assignment -name SLEW_RATE 0 -to LRCLK_FB
