(version 1)

# Manufacturing and routing constraints for the DAC-HPA review layout.
# KiCad DRC checks geometry; routed length, EMI returns and JLC assembly
# acceptance also require the separate reviews and physical gates.

(rule "L2 is continuous GND, with no signal tracks"
    (layer In1.Cu)
    (constraint disallow track))

(rule "L2 pour belongs to GND only"
    (layer In1.Cu)
    (condition "A.Type == 'Zone' && A.NetName != 'GND'")
    (constraint disallow zone))

(rule "All footprints are top side"
    (layer B.Cu)
    (constraint disallow footprint))

(rule "No L4 routing or pour under J701"
    (layer B.Cu)
    (condition "A.intersectsCourtyard('J701')")
    (constraint disallow track via zone))

(rule "USB pair L1 only"
    (layer B.Cu)
    (condition "A.NetName == 'USB_DP' || A.NetName == 'USB_DN'")
    (constraint disallow track via))

(rule "USB pair no internal-layer tracks"
    (layer inner)
    (condition "A.NetName == 'USB_DP' || A.NetName == 'USB_DN'")
    (constraint disallow track via))

(rule "USB pair width with short pad neckdowns"
    (condition "A.NetName == 'USB_DP' || A.NetName == 'USB_DN'")
    (constraint track_width (min 0.15mm) (opt 0.235mm) (max 0.235mm)))

(rule "MCLK and I2S L1 only"
    (layer B.Cu)
    (condition "A.NetName == 'MCLK' || A.NetName == 'FAM_CLK' || A.NetName == 'BCLK' || A.NetName == 'LRCLK' || A.NetName == 'SDATA'")
    (constraint disallow track via))

(rule "MCLK and I2S no internal tracks"
    (layer inner)
    (condition "A.NetName == 'MCLK' || A.NetName == 'FAM_CLK' || A.NetName == 'BCLK' || A.NetName == 'LRCLK' || A.NetName == 'SDATA'")
    (constraint disallow track via))

# The two source-to-DAC segments straddle R203. The combined limit is 10 mm.
(rule "X201 to R203 clock segment"
    (condition "A.fromTo('X201-3', 'R203-1')")
    (constraint length (max 2mm)))

(rule "R203 to DAC clock segment"
    (condition "A.fromTo('R203-2', 'U301-7')")
    (constraint length (max 8mm)))

(rule "DAC inputs no vias"
    (condition "A.NetName == 'DACL' || A.NetName == 'DACLB' || A.NetName == 'DACR' || A.NetName == 'DACRB'")
    (constraint disallow via))

(rule "Headphone output width including VSON pad escapes"
    (condition "A.NetName == 'LEG_LP' || A.NetName == 'LEG_LN' || A.NetName == 'LEG_RP' || A.NetName == 'LEG_RN' || A.NetName == 'JACK_LP' || A.NetName == 'JACK_LN' || A.NetName == 'JACK_RP' || A.NetName == 'JACK_RN'")
    (constraint track_width (min 0.25mm)))

# JACK_* stays on L1 without vias. LEG_* amp -> relay current paths are
# routed on L1; the long LEG_* sense taps to the 330 k-1 M detector resistors
# (spec R07: slow analog on L4 over GND) may use vias and inner layers.
(rule "Headphone outputs L1 only, no vias"
    (layer B.Cu)
    (condition "A.NetName == 'JACK_LP' || A.NetName == 'JACK_LN' || A.NetName == 'JACK_RP' || A.NetName == 'JACK_RN'")
    (constraint disallow track via))

(rule "Headphone outputs no inner-layer tracks or vias"
    (layer inner)
    (condition "A.NetName == 'JACK_LP' || A.NetName == 'JACK_LN' || A.NetName == 'JACK_RP' || A.NetName == 'JACK_RN'")
    (constraint disallow track via))

(rule "Headphone outputs no vias"
    (condition "A.NetName == 'JACK_LP' || A.NetName == 'JACK_LN' || A.NetName == 'JACK_RP' || A.NetName == 'JACK_RN'")
    (constraint disallow via))

(rule "Headphone left-right copper separation"
    (layer F.Cu)
    (condition "((A.NetName == 'LEG_LP' || A.NetName == 'LEG_LN' || A.NetName == 'JACK_LP' || A.NetName == 'JACK_LN') && (B.NetName == 'LEG_RP' || B.NetName == 'LEG_RN' || B.NetName == 'JACK_RP' || B.NetName == 'JACK_RN')) || ((B.NetName == 'LEG_LP' || B.NetName == 'LEG_LN' || B.NetName == 'JACK_LP' || B.NetName == 'JACK_LN') && (A.NetName == 'LEG_RP' || A.NetName == 'LEG_RN' || A.NetName == 'JACK_RP' || A.NetName == 'JACK_RN'))")
    (constraint clearance (min 2mm)))

# J701's manufacturer-defined contact pitch does not permit 2 mm clearance
# at the plated pads. Limit this exception to tracks crossing its courtyard;
# the 2 mm rule remains in force once the four outputs leave the jack.
(rule "J701 fixed-contact fanout clearance"
    (layer F.Cu)
    (condition "((A.Type == 'Track' && A.intersectsCourtyard('J701') && B.memberOfFootprint('J701')) || (B.Type == 'Track' && B.intersectsCourtyard('J701') && A.memberOfFootprint('J701')))")
    (constraint clearance (min 0.2mm)))

# Track-to-track and track-to-pad checks activate when copper is drawn.
# The read-only placement audit separately reports pad-to-pad proximity.
# Protect only analog/high-impedance nodes. The four U621 buffered logic
# readbacks are excluded from the 5 mm analog keepout; BUF_IN stays in.
# The placement audit uses the same susceptibility list.
(rule "High-impedance low-level nets versus clocks 10 mm"
    (layer F.Cu)
    (condition "(A.Type == 'Track' || B.Type == 'Track') && (((A.NetName == 'N6_VLL*' || A.NetName == 'N6_VOR*') && (B.NetName == 'MCLK' || B.NetName == 'N2_X201_OUT' || B.NetName == 'N6_MCK_IN' || B.NetName == 'N6_MCK_BUF' || B.NetName == 'N6_PMP' || B.NetName == 'FAM_CLK' || B.NetName == 'BCLK' || B.NetName == 'LRCLK' || B.NetName == 'SDATA' || B.NetName == 'LINK_SCK')) || ((B.NetName == 'N6_VLL*' || B.NetName == 'N6_VOR*') && (A.NetName == 'MCLK' || A.NetName == 'N2_X201_OUT' || A.NetName == 'N6_MCK_IN' || A.NetName == 'N6_MCK_BUF' || A.NetName == 'N6_PMP' || A.NetName == 'FAM_CLK' || A.NetName == 'BCLK' || A.NetName == 'LRCLK' || A.NetName == 'SDATA' || A.NetName == 'LINK_SCK')))")
    (constraint clearance (min 10mm)))

(rule "Protection V3 analog nodes versus clocks 5 mm"
    (layer F.Cu)
    (condition "(A.Type == 'Track' || B.Type == 'Track') && (((A.NetName == 'N6_V3*' && A.NetName != 'N6_V3AG_A_BUF_OUT' && A.NetName != 'N6_V3AG_B_BUF_OUT' && A.NetName != 'N6_V3AG_A_MCU' && A.NetName != 'N6_V3AG_B_MCU') && (B.NetName == 'MCLK' || B.NetName == 'N2_X201_OUT' || B.NetName == 'N6_MCK_IN' || B.NetName == 'N6_MCK_BUF' || B.NetName == 'N6_PMP' || B.NetName == 'FAM_CLK' || B.NetName == 'BCLK' || B.NetName == 'LRCLK' || B.NetName == 'SDATA' || B.NetName == 'LINK_SCK')) || ((B.NetName == 'N6_V3*' && B.NetName != 'N6_V3AG_A_BUF_OUT' && B.NetName != 'N6_V3AG_B_BUF_OUT' && B.NetName != 'N6_V3AG_A_MCU' && B.NetName != 'N6_V3AG_B_MCU') && (A.NetName == 'MCLK' || A.NetName == 'N2_X201_OUT' || A.NetName == 'N6_MCK_IN' || A.NetName == 'N6_MCK_BUF' || A.NetName == 'N6_PMP' || A.NetName == 'FAM_CLK' || A.NetName == 'BCLK' || A.NetName == 'LRCLK' || A.NetName == 'SDATA' || A.NetName == 'LINK_SCK')))")
    (constraint clearance (min 5mm)))

(rule "Protection timer and OR analog nodes versus clocks 5 mm"
    (layer F.Cu)
    (condition "(A.Type == 'Track' || B.Type == 'Track') && (((A.NetName == 'N6_TW*' || A.NetName == 'N6_LW*' || (A.NetName == 'N6_OR*' && A.NetName != 'N6_ORTEST')) && (B.NetName == 'MCLK' || B.NetName == 'N2_X201_OUT' || B.NetName == 'N6_MCK_IN' || B.NetName == 'N6_MCK_BUF' || B.NetName == 'N6_PMP' || B.NetName == 'FAM_CLK' || B.NetName == 'BCLK' || B.NetName == 'LRCLK' || B.NetName == 'SDATA' || B.NetName == 'LINK_SCK')) || ((B.NetName == 'N6_TW*' || B.NetName == 'N6_LW*' || (B.NetName == 'N6_OR*' && B.NetName != 'N6_ORTEST')) && (A.NetName == 'MCLK' || A.NetName == 'N2_X201_OUT' || A.NetName == 'N6_MCK_IN' || A.NetName == 'N6_MCK_BUF' || A.NetName == 'N6_PMP' || A.NetName == 'FAM_CLK' || A.NetName == 'BCLK' || A.NetName == 'LRCLK' || A.NetName == 'SDATA' || A.NetName == 'LINK_SCK')))")
    (constraint clearance (min 5mm)))

# The four protection RC/bleed branches have an 8 mm pad-to-pad routed limit.
(rule "LP_L capacitor timer route" (condition "A.fromTo('U609-8', 'C631-1')") (constraint length (max 8mm)))
(rule "LP_L bleed timer route" (condition "A.fromTo('U609-8', 'Q623-3')") (constraint length (max 8mm)))
(rule "LP_L charge timer route" (condition "A.fromTo('U609-8', 'R920-2')") (constraint length (max 8mm)))
(rule "LN_L capacitor timer route" (condition "A.fromTo('U609-10', 'C632-1')") (constraint length (max 8mm)))
(rule "LN_L bleed timer route" (condition "A.fromTo('U609-10', 'Q624-3')") (constraint length (max 8mm)))
(rule "LN_L charge timer route" (condition "A.fromTo('U609-10', 'R921-2')") (constraint length (max 8mm)))
(rule "LP_R capacitor timer route" (condition "A.fromTo('U610-8', 'C633-1')") (constraint length (max 8mm)))
(rule "LP_R bleed timer route" (condition "A.fromTo('U610-8', 'Q625-3')") (constraint length (max 8mm)))
(rule "LP_R charge timer route" (condition "A.fromTo('U610-8', 'R922-2')") (constraint length (max 8mm)))
(rule "LN_R capacitor timer route" (condition "A.fromTo('U610-10', 'C634-1')") (constraint length (max 8mm)))
(rule "LN_R bleed timer route" (condition "A.fromTo('U610-10', 'Q626-3')") (constraint length (max 8mm)))
(rule "LN_R charge timer route" (condition "A.fromTo('U610-10', 'R923-2')") (constraint length (max 8mm)))

# The six provisional <=4.2 mm local jack-to-TVS limits are measured between
# named pads by audit_local_tvs_paths.py. KiCad's length constraint can include
# another contact/relay branch of a JACK net and falsely fail a 4.03 mm path.
# Keep ordinary copper and via rules here; the audit is mandatory in CI.

# The maker's adjacent plated contacts in J701 are fixed at their drawing
# pitch. They remain subject to the ordinary copper-clearance rule.
(rule "J701 maker contact pad exception"
    (condition "A.memberOfFootprint('J701') && B.memberOfFootprint('J701')")
    (constraint clearance (min 0.2mm)))

(rule "VBUS and 5V_SYS width"
    (condition "A.NetName == 'VBUS' || A.NetName == '5V_SYS'")
    (constraint track_width (min 1mm)))

(rule "5V_ANA feed width"
    (condition "A.NetName == '5V_ANA' || A.NetName == '5V_ANA_F'")
    (constraint track_width (min 0.8mm)))

# U501's 0.28 mm-wide VIN lands at 0.50 mm pitch need short 0.20 mm
# top-side escapes. The integrated-board checker bounds their lengths and
# rejects any 5V_ANA_F fine track outside this one WSON courtyard.
(rule "U501 VIN WSON local escape"
    (layer F.Cu)
    (condition "A.NetName == '5V_ANA_F' && A.intersectsCourtyard('U501')")
    (constraint track_width (min 0.20mm)))

# These three small power lands cannot launch a centred 1 mm trunk. Only one
# short escape per land is permitted; audit_power_pad_escapes.py enforces the
# exact pad endpoint and length before the trace widens to the 1 mm trunk.
(rule "J101 VBUS local pad escape"
    (layer F.Cu)
    (condition "A.NetName == 'VBUS' && A.intersectsCourtyard('J101')")
    (constraint track_width (min 0.50mm)))

(rule "U102 and U504 WSON local power pad escape"
    (layer F.Cu)
    (condition "(A.NetName == 'VBUS' || A.NetName == '5V_SYS') && (A.intersectsCourtyard('U102') || A.intersectsCourtyard('U504'))")
    (constraint track_width (min 0.30mm)))

(rule "Jack hand-solder access"
    (constraint courtyard_clearance (min 1.5mm))
    (condition "A.Reference == 'J701' || B.Reference == 'J701' || A.Reference == 'J702' || B.Reference == 'J702'"))

(rule "Owner-fitted relay access"
    (constraint courtyard_clearance (min 1.5mm))
    (condition "A.Reference == 'K601' || A.Reference == 'K602' || A.Reference == 'K603' || A.Reference == 'K604' || B.Reference == 'K601' || B.Reference == 'K602' || B.Reference == 'K603' || B.Reference == 'K604'"))

(rule "Film capacitor owner-fit fallback access"
    (constraint courtyard_clearance (min 1.5mm))
    (condition "A.Reference == 'C631' || A.Reference == 'C632' || A.Reference == 'C633' || A.Reference == 'C634' || B.Reference == 'C631' || B.Reference == 'C632' || B.Reference == 'C633' || B.Reference == 'C634'"))

# C638 is the local VNEG bypass between the two right timer film capacitors.
# The side gap is 0.60 mm; audit_film_solder_access.py checks ≥1.5 mm clear
# north/south approaches to both exposed solder terminals before owner fit.
(rule "Right film capacitor side gap to C638"
    (condition "((A.Reference == 'C633' || A.Reference == 'C634') && B.Reference == 'C638') || ((B.Reference == 'C633' || B.Reference == 'C634') && A.Reference == 'C638')")
    (constraint courtyard_clearance (min 0.60mm)))

# The matching U609 bypass has the same owner-fit side access tradeoff.
# audit_film_solder_access.py checks both exposed terminal approaches.
(rule "Left film capacitor side gap to C636"
    (condition "((A.Reference == 'C631' || A.Reference == 'C632') && B.Reference == 'C636') || ((B.Reference == 'C631' || B.Reference == 'C632') && A.Reference == 'C636')")
    (constraint courtyard_clearance (min 0.60mm)))

# The named-pad audit also measures D707/D708 near J702. Routed ESD return,
# nonlinear TVS loading and system IEC testing remain separate release gates.

(rule "Output amp pre-link left-right clearance study"
  (layer F.Cu)
  (condition "((A.NetName == 'N4_LP_OUT' || A.NetName == 'N4_LN_OUT') && (B.NetName == 'N4_RP_OUT' || B.NetName == 'N4_RN_OUT' || B.NetName == 'LEG_RP' || B.NetName == 'LEG_RN' || B.NetName == 'JACK_RP' || B.NetName == 'JACK_RN')) || ((B.NetName == 'N4_LP_OUT' || B.NetName == 'N4_LN_OUT') && (A.NetName == 'N4_RP_OUT' || A.NetName == 'N4_RN_OUT' || A.NetName == 'LEG_RP' || A.NetName == 'LEG_RN' || A.NetName == 'JACK_RP' || A.NetName == 'JACK_RN')) || ((A.NetName == 'N4_RP_OUT' || A.NetName == 'N4_RN_OUT') && (B.NetName == 'LEG_LP' || B.NetName == 'LEG_LN' || B.NetName == 'JACK_LP' || B.NetName == 'JACK_LN')) || ((B.NetName == 'N4_RP_OUT' || B.NetName == 'N4_RN_OUT') && (A.NetName == 'LEG_LP' || A.NetName == 'LEG_LN' || A.NetName == 'JACK_LP' || A.NetName == 'JACK_LN'))")
  (constraint clearance (min 2mm)))

# EMS pours (L1/L3/L4 GND, stitched to L2). Design Notes v1.0 §9.3: the USB
# pair keeps >= 0.6 mm to coplanar GND pour; the supervisor/LPW high-impedance
# nodes keep >= 0.5 mm to all other copper, including pour, for leakage.
(rule "USB pair to GND pour"
    (condition "A.Type == 'Zone' && (B.NetName == 'USB_DP' || B.NetName == 'USB_DN')")
    (constraint clearance (min 0.6mm)))

(rule "High-impedance nodes to GND pour"
    (condition "A.Type == 'Zone' && (B.NetName == 'N6_LW*' || B.NetName == 'N6_TW*' || B.NetName == 'N6_ORLP' || B.NetName == 'N6_ORLN' || B.NetName == 'N6_ORRP' || B.NetName == 'N6_ORRN' || B.NetName == 'N6_TLP_*' || B.NetName == 'N6_TLN_*' || B.NetName == 'N6_V3R_*' || B.NetName == 'N6_V3AG_A' || B.NetName == 'N6_V3AG_B' || B.NetName == 'N6_VOR*' || B.NetName == 'N6_VLL*' || B.NetName == 'N6_DA_*' || B.NetName == 'N6_DB_*' || B.NetName == 'N6_DC_*' || B.NetName == 'N6_DD_*' || B.NetName == 'N6_VT' || B.NetName == 'N6_CML' || B.NetName == 'N6_CMR' || B.NetName == 'N6_MCK_RC')")
    (constraint clearance (min 0.5mm)))
